# Ethereum address to receive payments (server side)
SERVER_ADDRESS=0xYourWalletAddressHere

# Private key for signing payments (client side — test only, never use a real key)
CLIENT_TEST_PK=0xYourPrivateKeyHere

# Optional: also accept payment on Solana devnet. The address must already
# hold a devnet USDC token account, or verification fails.
# SERVER_SOLANA_ADDRESS=YourSolanaAddressHere

# Optional: base58 secret key for paying on Solana devnet (test only)
# CLIENT_SOLANA_TEST_KEY=YourBase58SecretKeyHere

# Optional: Solana RPC for the paying agent. Defaults to the public devnet RPC,
# which rejects requests from deployed Workers.
# SOLANA_RPC_URL=https://your-devnet-rpc.example.com
